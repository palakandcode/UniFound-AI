# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/unifind

# Server
PORT=5000
CLIENT_URL=http://127.0.0.1:5500
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# University policy
ALLOWED_EMAIL_DOMAIN=somaiya.edu

# Email OTP (optional until configured)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=UniFind AI <noreply@your-verified-domain.example>

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Uploads
MAX_UPLOAD_MB=5
